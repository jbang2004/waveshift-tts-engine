# WaveShift TTS Engine environment example.
# Copy this file to .env and replace placeholders with development credentials.
# Never commit .env or real secrets.

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=DEBUG
FLASK_ENV=development

# Cloudflare D1/R2. Required for runtime startup.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_r2_bucket_name

# Translation simplification provider.
# Supported values: deepseek, gemini, grok, groq
TRANSLATION_MODEL=deepseek
DEEPSEEK_API_KEY=your_deepseek_key_here
GEMINI_API_KEY=your_gemini_key_here
XAI_API_KEY=your_xai_key_here
GROQ_API_KEY=your_groq_key_here

# Audio processing
BATCH_SIZE=20
TARGET_SPEAKER_AUDIO_DURATION=10
VAD_SR=16000
TARGET_SR=24000
VOCALS_VOLUME=0.7
BACKGROUND_VOLUME=0.3
AUDIO_OVERLAP=1024
SILENCE_FADE_MS=25
NORMALIZATION_THRESHOLD=0.9
SAVE_TTS_AUDIO=true
CLEANUP_TEMP_FILES=false

# Vocal separation
ENABLE_VOCAL_SEPARATION=true
VOCAL_SEPARATION_MODEL=Kim_Vocal_2.onnx
VOCAL_SEPARATION_OUTPUT_FORMAT=WAV
VOCAL_SEPARATION_SAMPLE_RATE=24000
VOCAL_SEPARATION_TIMEOUT=300

# Audio clipping
AUDIO_CLIP_GOAL_DURATION_MS=12000
AUDIO_CLIP_MIN_DURATION_MS=1000
AUDIO_CLIP_PADDING_MS=200
AUDIO_CLIP_ALLOW_CROSS_NON_SPEECH=false

# HLS output
ENABLE_HLS_STORAGE=true
HLS_STORAGE_BUCKET=hls-streams
CLEANUP_LOCAL_HLS_FILES=true
SEGMENT_MINUTES=5
MIN_SEGMENT_MINUTES=3

# Runtime tuning
SIMPLIFICATION_BATCH_SIZE=50
TTS_BATCH_SIZE=3
MAX_PARALLEL_SEGMENTS=2
SIMPLIFIER_ACTOR_NUM_CPUS=0.5
MEDIA_MIXER_ACTOR_NUM_CPUS=0.5

# Memory management
MAX_BUFFER_DURATION=10.0
MEMORY_THRESHOLD_MB=500
CLEANUP_INTERVAL=5
